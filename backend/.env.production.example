# SAYNTRA API: development-preview / production template.
# Set these in the hosting provider's secret manager. Never commit real values.
APP_NAME=SAYNTRA
APP_ENV=production
APP_DEBUG=false
# Generate once with `php artisan key:generate --show` and keep a secure backup.
APP_KEY=
# Public HTTPS URL of this Laravel API (used for signed email links).
APP_URL=https://api.example.com
# Public HTTPS URL of the Next.js app on Vercel (redirects and email links).
FRONTEND_URL=https://sayntra-preview.vercel.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Managed MySQL 8 (private networking / TLS where the provider supports it).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=sayntra
DB_USERNAME=
DB_PASSWORD=

# The browser only talks to the Vercel domain; Next.js proxies /api and
# /sanctum here, so cookies are first-party on that domain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Host names only, comma separated. Add each stable preview/production host.
SANCTUM_STATEFUL_DOMAINS=sayntra-preview.vercel.app
# Proxies in front of the API (the host's load balancer). See bootstrap/app.php.
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Transactional email over SMTP (e.g. Resend, Postmark, Brevo, Mailgun).
# Verify the sending domain (SPF/DKIM) with the provider first.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SAYNTRA
