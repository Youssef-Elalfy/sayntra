# SAYNTRA frontend on Vercel. Set in Project Settings → Environment Variables.
# "preview" shows the development banner and sets noindex; use "production"
# only after the launch is approved.
NEXT_PUBLIC_DEPLOY_STAGE=preview
# Laravel API origin used by the server-side rewrites for /api and /sanctum.
API_INTERNAL_URL=https://api.example.com
# Leave empty: the browser uses same-origin /api through the rewrites.
NEXT_PUBLIC_API_URL=
